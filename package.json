{
  "name": "nectrix",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "php -S 127.0.0.1:8080 -t api/public api/public/index.php",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "licenses": "node scripts/check-licenses.mjs",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest run",
    "test:backend": "php api/tests/run.php"
  },
  "dependencies": {
    "@tiptap/core": "3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "svelte": "5.56.10"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "jsdom": "30.0.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
